<section class="section hero" id="Hero">
    <div class="section__container hero__container">
        <div class="hero__information">
            <h1 class="hero__title font1">Brilla en tu propia piel</h1>
            <p class="hero__text">Una experiencia de belleza que combina tecnología estética y técnicas manuales expertas.</p>
        </div>
    </div>
</section>

<style>
  @reference "@/styles/app.css";

  .hero{
    @apply w-full bg-[url('../../assets/images/header.png')] bg-cover bg-[center_left_550px] sm:bg-center;
  }

  .hero__container {
    @apply h-90 sm:h-65 md:h-80 lg:h-105 xl:h-135 2xl:h-155 grid grid-cols-[10fr_auto] md:grid-cols-[3fr_2.6fr] ;
  }

  .hero__information{
    @apply  w-full flex flex-col gap-10 md:gap-5 place-content-center md:pt-23 lg:pt-32 xl:pt-35 2xl:pt-48;
  }

  .hero__title{
    @apply w-full text-4xl md:text-[56px] leading-[100%] text-primary mb-3 md:mb-2;
  }

  .hero__text{
    @apply md:text-start max-w-[190px] md:max-w-none leading-[100%] sm:text-xl lg:text-xl xl:text-2xl 2xl:text-[28px] text-primary justify-self-center font-bacasime-antique;
  }
</style>

<script>
  addEventListener('DOMContentLoaded', () => {
    const hero = document.querySelector('.hero');
    const title = document.querySelector('.hero__information');

    (title as HTMLElement).style.opacity = '0';
    (hero as HTMLElement).style.opacity = '0';

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && hero ? hero.classList.add('fadeIn') : null;
      },
      { threshold: 0 }
    );
    hero ? observer.observe(hero) : null;

    const infoObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && title ? title.classList.add('fadeInFromLeft') : null;
      },
      { threshold: 0 }
    );
    title ? infoObserver.observe(title) : null;
  });
</script>