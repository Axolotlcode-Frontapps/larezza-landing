---
import { Image } from "astro:assets";
import Img from "@/assets/images/apparatus.png";
// import { ScrollArea } from "@/ui/shared/scroll-area";
import { CardService } from "../shared/service-cards";
import { ServicesCarrousel } from "./CarrouselServices";

const data = [
  {
    title: "EMS (Electroestimulación Muscular)",
    items: [
      "Contracciones profundas que tonifican sin esfuerzo físico.",
      "Fortalece y define músculos.",
    ],
  },
  {
    title: "Cavitación",
    items: [
      "Reduce grasa localizada con ondas ultrasónicas.",
      "Favorece la remodelación sin cirugía.",
    ],
  },
  {
    title: "Vacuum (Vacumterapia)",
    items: [
      "Succión controlada que mejora circulación y drenaje linfático.",
      "Reduce celulitis y retención de líquidos.",
    ],
  },
  {
    title: "Radiofrecuencia",
    items: [
      "Estimula colágeno y elastina.",
      "Reafirma y mejora la textura del rostro y cuerpo.",
    ],
  },
  {
    title: "Criolipólisis",
    items: [
      "Congela y elimina grasa localizada.",
      "Modela la figura de forma progresiva y no invasiva.",
    ],
  },
  {
    title: "Lipoláser",
    items: [
      "Láser de baja intensidad que libera grasa acumulada.",
      "Potencia los resultados reductivos.",
    ],
  },
];
---

<section class="section apparatus" id="apparatus">
  <div class="section__container apparatus__container">
    <Image src={Img} alt="statistics" class="apparatus__image" />
    <div class="apparatus__information">
      <h1 class="apparatus__title">Aparatología Corporal</h1>
      <p class="apparatus__text">
        Moldea tu figura sin cirugía, reduce volumen y consigue firmeza con
        resultados naturales duraderos.
      </p>
      <!-- <ScrollArea className="h-[580px] px-3 lg:px-0" client:visible> -->
      <div class="apparatus__cards desktop">
        {data.map((card) => <CardService {...card} />)}
      </div>
      <div class="apparatus__cards mobile">
        <ServicesCarrousel {data} client:load />
      </div>
      <!-- </ScrollArea> -->
    </div>
  </div>
</section>

<style>
  @reference "@/styles/app.css";

  .apparatus {
    @apply bg-gradient-to-t from-white via-foreground to-white;
  }

  .apparatus__container {
    @apply w-full grid grid-cols-1 lg:grid-cols-2 sm:justify-between gap-8 xl:gap-20 2xl:gap-40 py-10;
  }

  .apparatus__information {
    @apply w-full;
  }

  .apparatus__title {
    @apply text-4xl md:text-[48px] leading-[100%] text-start text-primary font-medium mb-3 font-bacasime-antique;
  }

  .apparatus__text {
    @apply  text-2xl leading-[110%] text-primary mb-3 text-start;
  }

  .apparatus__cards {
    @apply grid-cols-1 lg:grid-cols-2 gap-4 pt-3;
  }

  .apparatus__image {
    @apply w-full max-w-[500px]! object-contain self-start;
  }
</style>

<script>
  addEventListener("DOMContentLoaded", () => {
    const info = document.querySelector(".apparatus__information");
    // const image = document.querySelector(".apparatus__image");

    (info as HTMLElement).style.opacity = "0";
    // (image as HTMLElement).style.opacity = "0";

    const infoObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && info ? info.classList.add("fadeInFromLeft") : null;
      },
      { threshold: 0 }
    );
    info && infoObserver.observe(info);

    // const imageObserver = new IntersectionObserver(
    //   ([entry]) => {
    //     if (!entry) return;
    //     const isVisible = entry.isIntersecting;
    //     isVisible && image ? image.classList.add("fadeInFromRight") : null;
    //   },
    //   { threshold: 0 },
    // );
    // image && imageObserver.observe(image);
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const desktop = gsap.matchMedia();

  desktop.add("(min-width: 1024px)", () => {
    gsap.timeline({
      scrollTrigger: {
        trigger: ".apparatus__image",
        start: "top 15%",
        end: "+=830",
        scrub: true,
        pin: true,
      },
    });
  });
</script>
