---
import { Image } from "astro:assets";
import ImageSection from "../../assets/images/essence.svg";
---

<section class="section essence" id="AboutUs">
  <div class="section__container essence__container">
    <div class="essence__information">
      <h1 class="essence__title">Nuestra esencia</h1>
      <p class="essence__text">
        En <span class="essence__span">Larezza</span> creemos que la verdadera belleza
        surge cuando cuerpo y alma están en equilibrio.
      </p>
      <!-- <p class="essence__text">No transformamos, revelamos tu luz interior.</p> -->
    </div>
    <div class="essence__image">
      <Image src={ImageSection} alt="essence image" class="w-full" />
    </div>
  </div>
</section>

<style>
  @reference "@/styles/app.css";

  .essence {
    @apply bg-gradient-to-t from-white via-foreground to-white;
  }

  .essence__container {
    @apply grid grid-cols-1 md:grid-cols-[2fr_3fr] py-10;
  }

  .essence__information {
    @apply text-center md:text-left md:place-content-center;
  }

  .essence__title {
    @apply text-4xl md:text-[48px] leading-[100%] text-start text-primary font-medium mb-3 font-bacasime-antique;
  }

  .essence__text {
    @apply text-2xl leading-[110%] text-primary mb-6 md:mr-5 text-start;
  }

  .essence__span {
    @apply font-bold;
  }

  .essence__image {
    @apply flex justify-center md:justify-end;
  }
</style>

<script>
  addEventListener("DOMContentLoaded", () => {
    const info = document.querySelector(".essence__information");
    const image = document.querySelector(".essence__image");

    (info as HTMLElement).style.opacity = "0";
    (image as HTMLElement).style.opacity = "0";

    const infoObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && info ? info.classList.add("fadeInFromLeft") : null;
      },
      { threshold: 0 },
    );
    info && infoObserver.observe(info);

    const imageObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && image ? image.classList.add("fadeInFromLeft") : null;
      },
      { threshold: 0 },
    );
    image && imageObserver.observe(image);
  });
</script>
