---
import { Image } from "astro:assets";
import Img from "@/assets/images/hair1.png";
import { ScrollArea } from "@/ui/shared/scroll-area";
import { CardService } from "../shared/service-cards";

const data = [
  {
    title: "Depilación Láser con Diodo",
    items: [
      "Elimina el vello desde la raíz de forma segura y duradera ayudando a reducir el crecimiento progresivamente",
      "Procedimiento seguro, eficaz y con resultados duraderos.",
      "Apto para todo tipo de piel y para cualquier zona del cuerpo.",
    ],
  },
];
---

<section class="section HairRemoval" id="hair-removal">
  <div class="section__container HairRemoval__container">
    <div class="HairRemoval__information">
      <h1 class="HairRemoval__title">Depilación</h1>
      <p class="HairRemoval__text">
        Olvídate del vello, disfruta suavidad duradera y vive una experiencia
        láser segura, elegante y confortable siempre.
      </p>
      <ScrollArea className="h-full px-3 lg:px-0" client:visible>
        <div class="HairRemoval__cards">
          {data.map((card) => <CardService {...card} />)}
        </div>
      </ScrollArea>
    </div>

    <Image src={Img} alt="statistics" class="HairRemoval__image" />
  </div>
</section>

<style>
  @reference "@/styles/app.css";

  .HairRemoval {
    @apply bg-gradient-to-t from-white via-foreground to-white;
  }

  .HairRemoval__container {
    @apply w-full grid grid-cols-1 md:grid-cols-2 sm:justify-between gap-8 xl:gap-40 py-10;
  }

  .HairRemoval__information {
    @apply w-full ;
  }

  .HairRemoval__title {
    @apply text-center lg:text-left text-3xl md:text-6xl text-primary font-medium mb-3;
  }

  .HairRemoval__text {
    @apply text-center lg:text-left text-xl md:text-2xl text-primary mb-3;
  }

  .HairRemoval__cards {
    @apply grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-4 pt-3;
  }

  .HairRemoval__image {
    @apply w-full max-w-[500px] object-contain self-start;
  }
</style>

<script>
  addEventListener("DOMContentLoaded", () => {
    const info = document.querySelector(".HairRemoval__information");
    const image = document.querySelector(".HairRemoval__image");

    (info as HTMLElement).style.opacity = "0";
    (image as HTMLElement).style.opacity = "0";

    const infoObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && info ? info.classList.add("fadeInFromLeft") : null;
      },
      { threshold: 0 },
    );
    info && infoObserver.observe(info);

    const imageObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && image ? image.classList.add("fadeIn") : null;
      },
      { threshold: 0 },
    );
    image && imageObserver.observe(image);
  });
</script>
