---
import { Image } from "astro:assets";
import Img from "@/assets/images/facials.png";
// import { ScrollArea } from "@/ui/shared/scroll-area";
import { CardService } from "../shared/service-cards";
import { ServicesCarrousel } from "./CarrouselServices";

const data = [
  {
    title: "Facial Hidrodermoabrasión",
    items: [
      "Hidrata, nutre, suaviza, ilumina y revitaliza.",
      "Restaura la humedad natural mejorando su suavidad, elasticidad y brillo.",
      "Ideal para piel seca o deshidratada.",
    ],
  },
  {
    title: "Facial Despigmentante",
    items: [
      "Aclara, unifica, mejora, renueva y suaviza.",
      "Reduce manchas oscuras y ayuda a unificar el tono de la piel.",
      "Aporta luminosidad.",
    ],
  },
  {
    title: "Facial limpieza profunda",
    items: [
      "Limpia, purifica, equilibra, renueva y desintoxica.",
      "Elimina impurezas, puntos negros y exceso de grasa.",
      "Deja la piel limpia y equilibrada.",
    ],
  },
  {
    title: "Hollywood peel",
    items: [
      "Limpia, exfolia y rejuvenece con láser.",
      "Combina láser con carbón activado para exfoliar, cerrar poros, reducir manchas y rejuvenecer la piel.",
      "Reduce grasa, acné y pigmentación irregular.",
    ],
  },
];
---

<section class="section facials" id="facials">
  <div class="section__container facials__container">
    <Image src={Img} alt="statistics" class="facials__image" />
    <div class="facials__information">
      <h1 class="facials__title">Faciales</h1>
      <p class="facials__text">
        Ilumina tu piel, renueva tu textura y descubre resultados visibles con
        protocolos faciales de alta estética.
      </p>
      <!-- <ScrollArea className="h-full px-3 lg:px-0" client:visible> -->
      <div class="facials__cards desktop">
        {data.map((card) => <CardService {...card} />)}
      </div>
      <div class="facials__cards mobile">
        <ServicesCarrousel {data} client:load />
      </div>
      
      <!-- </ScrollArea> -->
    </div>
  </div>
</section>

<style>
  @reference "@/styles/app.css";

  .facials {
    @apply bg-gradient-to-t from-white via-foreground to-white;
  }

  .facials__container {
    @apply w-full grid grid-cols-1 md:grid-cols-2 sm:justify-between gap-8 xl:gap-40 py-10;
  }

  .facials__information {
    @apply w-full;
  }

  .facials__title {
    @apply text-center lg:text-left text-3xl md:text-6xl text-primary font-medium mb-3;
  }

  .facials__text {
    @apply text-center lg:text-left text-xl md:text-2xl text-primary mb-3;
  }

  .facials__cards {
    @apply  grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-4 pt-3;
  }

  .facials__image {
    @apply w-full max-w-[500px] object-contain self-start;
  }
</style>

<script>
  addEventListener("DOMContentLoaded", () => {
    const info = document.querySelector(".facials__information");
    // const image = document.querySelector(".facials__image");

    (info as HTMLElement).style.opacity = "0";
    // (image as HTMLElement).style.opacity = "0";

    const infoObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        const isVisible = entry.isIntersecting;
        isVisible && info ? info.classList.add("fadeInFromLeft") : null;
      },
      { threshold: 0 }
    );
    info && infoObserver.observe(info);

    // const imageObserver = new IntersectionObserver(
    //   ([entry]) => {
    //     if (!entry) return;
    //     const isVisible = entry.isIntersecting;
    //     isVisible && image ? image.classList.add("fadeInFromRight") : null;
    //   },
    //   { threshold: 0 },
    // );
    // image && imageObserver.observe(image);
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add("(min-width: 1024px)", () => {
    gsap.timeline({
      scrollTrigger: {
        trigger: ".facials__image",
        start: "top 15%",
        end: "+=530",
        scrub: true,
        pin: true,
      },
    });
  });
</script>
