---
import WhatsappIcon from "@/assets/icons/whats.astro";
---

<div class="schedule group">
  <div
    class="schedule__message group-hover:opacity-0 group-hover:pointer-events-none transition-opacity duration-300"
  >
    ¡Agenda tu cita hoy mismo!
  </div>

  <a
    class="button-sticky group-hover:px-4 group peer"
    href="https://wa.link/dc586b"
    target="_blank"
    tabindex="-1"
    aria-label="Chat on WhatsApp"
  >
    <WhatsappIcon />
    <span
      class="inline-block h-0 transition-all animate-width-collapse group-hover:animate-width-expand"
    >
      Agéndala por WhatsApp
    </span>
  </a>
</div>

<style>
  @reference "@/styles/app.css";

  .schedule {
    @apply fixed right-6 bottom-6 z-40 flex gap-5 items-center;
  }

  .schedule__message {
    @apply text-black bg-white animate-bounce-in-left max-w-[250px] p-2.5 border border-border rounded-2xl drop-shadow-lg drop-shadow-black/20 relative z-20;

    &::before {
      @apply content-[''] absolute right-1.75 z-0 top-1/2 -translate-y-1/2 translate-x-full size-3.5 bg-white rotate-45 border-r border-t border-border;
    }
  }

  .button-sticky {
    @apply flex px-2 hover:gap-1 py-2 items-center justify-center rounded-full z-40 text-white font-medium bg-[#19c750] hover:bg-[#17b44a] transition-all duration-300 hover:scale-95 active:scale-90 shadow-lg shadow-black/20;
  }

  .button-sticky-image {
    @apply object-contain size-[48px];
  }
</style>
